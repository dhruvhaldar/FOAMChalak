<Configuration>
  <Virtualization>Enable</Virtualization>
  <MappedFolders>
    <MappedFolder>
      <!-- IMPORTANT: Update HostFolder path if you move FOAMFlask to a different location -->
      <HostFolder>e:\Misc\FOAMFlask</HostFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /c "timeout /t 3 &amp; start powershell.exe -ExecutionPolicy Bypass -NoExit -File C:\Users\WDAGUtilityAccount\Desktop\FOAMFlask\install.ps1 -SkipSandboxCheck"</Command>
  </LogonCommand>
</Configuration>
