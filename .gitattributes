# Auto detect text files and perform LF normalization
* text=auto

# Force lowercase paths for the .jules directory to prevent
# case sensitivity conflicts on Windows
.jules/** linguist-generated
.jules/** -diff

# Ensure consistent line endings for common file types
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
